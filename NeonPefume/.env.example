# ==============================================================================
# Configuration PostgreSQL
# ==============================================================================
POSTGRES_USER=parfumerie
POSTGRES_PASSWORD=parfumerie_secret
POSTGRES_DB=maison_verte
POSTGRES_PORT=5432

# URL utilisée par Prisma en développement local (hors Docker)
DATABASE_URL="postgresql://parfumerie:parfumerie_secret@localhost:5432/maison_verte?schema=public"

# ==============================================================================
# Administration (/admin)
# ==============================================================================
# Mot de passe d'accès au back-office /admin
ADMIN_PASSWORD="maisonverte-admin"

# Secret cryptographique pour signer le cookie HTTP-only d'administration
ADMIN_SESSION_SECRET="remplacez-ce-secret-par-une-chaine-aleatoire-longue"

# Passez à "true" en production derrière HTTPS
COOKIE_SECURE="false"

# ==============================================================================
# Paiement Stripe (optionnel — laissé vide pour le mode simulation démo)
# ==============================================================================
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
