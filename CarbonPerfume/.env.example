# ==============================================================================
# CARBON PERFUME — Configuration Environnement
# ==============================================================================

# URL PostgreSQL 16 (développement local hors Docker -> localhost:5432)
# En Docker Compose, cette variable est surchargée automatiquement vers db:5432
DATABASE_URL="postgresql://carbon:carbon_secret_2026@localhost:5432/carbon_perfume?schema=public"

# Identifiants PostgreSQL (utilisés par docker-compose.yml)
POSTGRES_USER="carbon"
POSTGRES_PASSWORD="carbon_secret_2026"
POSTGRES_DB="carbon_perfume"

# Back-office Administration (/admin)
ADMIN_PASSWORD="carbon-atelier-2026"
ADMIN_SESSION_SECRET="change-me-in-production-carbon-perfume-hmac-secret-2026"

# URL publique du site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Intégration Stripe (optionnelle — mode simulation réaliste activé par défaut si vide)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
